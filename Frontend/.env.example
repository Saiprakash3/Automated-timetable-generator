# ============================================================================
# AUTOMATED TIMETABLE GENERATOR - FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control (only .env.example should be tracked)

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Base URL for all API requests to the backend
# Must match the backend server URL and port
# Development: http://localhost:8000/api
# Production: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# ============================================================================
# APPLICATION METADATA
# ============================================================================
# Application title (used in browser tab and header)
VITE_APP_TITLE=Automated Timetable Generator

# Application version
VITE_APP_VERSION=1.0.0

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable/disable advanced features in development
VITE_ENABLE_DEV_TOOLS=true

# ============================================================================
# LOGGING
# ============================================================================
# Enable console logging in development
VITE_DEBUG=false
