# Environment Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

# Database URLs (use 3 separate databases for dev/test/prod)
db_dev=postgresql://user:password@localhost:5432/timetable_dev
db_test=postgresql://user:password@localhost:5432/timetable_test
db_prod=postgresql://user:password@localhost:5432/timetable_prod

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ===== CONFLICT DETECTION CONFIGURATION =====

# Working Hours & Breaks
WORKING_HOURS_START=9          # 9 AM
WORKING_HOURS_END=17           # 5 PM (8 hours total)
LUNCH_BREAK_MINUTES=60         # 1 hour lunch
SHORT_BREAKS_MINUTES=30        # Total for all short breaks (e.g., 2x 15min)
PERIOD_LENGTH_MINUTES=60       # 1 hour per period

# Faculty Scheduling Constraints
FACULTY_MAX_PERIODS_PER_DAY=6          # Calculated from working hours above
FACULTY_MAX_DAYS_PER_WEEK=5            # Max days teaching per week
FACULTY_MAX_LAB_DAYS_PER_WEEK=3        # Max days with lab assignments per week

# Lab Coordinator Scheduling Constraints
LAB_COORDINATOR_MAX_PERIODS_PER_DAY=4  # Stricter than faculty (more prep needed)
LAB_COORDINATOR_MAX_DAYS_PER_WEEK=5    # Max days with lab assignments per week

# Conflict Detection Behavior
ALLOW_BLOCKING_CONFLICTS_IN_DRAFT=false  # If true, admins can save draft with blocking conflicts (risky)
