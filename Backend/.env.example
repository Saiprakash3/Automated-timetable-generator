# ============================================================================
# AUTOMATED TIMETABLE GENERATOR - BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env to version control (only .env.example should be tracked)

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
# Options: development, test, production
APP_ENV=development

# Enable debug mode (set to false in production)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection strings
# Format: postgresql://username:password@host:port/database

# Development database
DB_DEV=postgresql://user:password@localhost:5432/timetable_dev

# Test database (used by pytest)
DB_TEST=postgresql://user:password@localhost:5432/timetable_test

# Production database
DB_PROD=postgresql://user:password@localhost:5432/timetable_prod

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens (MUST be at least 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-to-something-secure

# JWT algorithm for token signing
JWT_ALGORITHM=HS256

# Access token expiration time in hours
JWT_EXPIRATION_HOURS=8

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Base URL for frontend API requests
VITE_API_BASE_URL=http://localhost:8000/api

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origins for cross-origin requests
# Format: comma-separated list of URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ============================================================================
# WORKING HOURS CONFIGURATION
# ============================================================================
# School working hours (24-hour format)
WORKING_HOURS_START=9      # 9 AM
WORKING_HOURS_END=17       # 5 PM

# ============================================================================
# BREAK CONFIGURATION (in minutes)
# ============================================================================
# Duration of lunch break
LUNCH_BREAK_MINUTES=60

# Total time allocated for short breaks (tea, recess, etc.)
SHORT_BREAKS_MINUTES=30

# Duration of each class period/lecture
PERIOD_LENGTH_MINUTES=60

# ============================================================================
# FACULTY CONSTRAINTS
# ============================================================================
# Maximum number of periods (classes) a faculty can teach per day
FACULTY_MAX_PERIODS_PER_DAY=6

# Maximum number of days per week a faculty can be assigned
FACULTY_MAX_DAYS_PER_WEEK=5

# Maximum number of days per week for lab teaching
FACULTY_MAX_LAB_DAYS_PER_WEEK=3

# ============================================================================
# LAB COORDINATOR CONSTRAINTS
# ============================================================================
# Maximum periods per day for lab coordinators
LAB_COORDINATOR_MAX_PERIODS_PER_DAY=4

# Maximum days per week for lab coordinators
LAB_COORDINATOR_MAX_DAYS_PER_WEEK=5

# ============================================================================
# CONFLICT DETECTION BEHAVIOR
# ============================================================================
# Allow blocking conflicts (double-booking, etc.) in draft state
# Set to false to prevent saving timetables with blocking conflicts
ALLOW_BLOCKING_CONFLICTS_IN_DRAFT=false
